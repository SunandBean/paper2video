#!/usr/bin/env bash
# paper2video command line. One entry point for every step; works from any directory.
#
#   p2v setup                 install tools (Node packages, ffmpeg, headless Chromium, Python venv, voice model)
#   p2v doctor                show folders and what is installed
#   p2v fetch <arxiv link|id> download paper + license, create the job folder
#   p2v check <job>           mechanical claims check (must end FAIL 0, WARN 0)
#   p2v tts <job> [opts]      narration + timing (opts: --engine, --voice, --speed)
#   p2v preview <job>         contact sheets at every sentence midpoint
#   p2v render <job> [--manual|--allow-stale]
#   p2v collect               re-link every finished video into the videos folder
#   p2v smoke [--ko]          end-to-end toolchain test
#   p2v test                  fast regression tests (no tools or network needed)
#   p2v run <link> [overrides]  unattended run through `claude -p` (log in <work>/logs/)
#   p2v paths                 print the resolved folders as export lines
#
# Folders (details in scripts/p2v_paths.py): code stays in the skill folder, tools in P2V_TOOLS,
# jobs and videos in P2V_HOME (~/paper2video for installed copies). All four can be overridden by env vars.
set -euo pipefail
# Logical path (symlinked skill folders keep their ~/.claude/skills/... spelling, which is what permission rules see).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYSPY="$(command -v python3 || true)"
[ -n "$SYSPY" ] || { echo "p2v: python3 not found (need Python 3.10-3.13)"; exit 1; }
eval "$("$SYSPY" "$ROOT/scripts/p2v_paths.py" --shell)"
PY="$P2V_TOOLS/.venv/bin/python"

need_tools() {
  [ -x "$PY" ] && [ -d "$P2V_TOOLS/node_modules/three" ] && return 0
  echo "p2v: tools are not installed yet ($P2V_TOOLS). Run: $ROOT/p2v setup"; exit 3
}
need_job() {
  [ -n "${1:-}" ] || { echo "usage: p2v $CMD <job>"; exit 2; }
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "p2v: '$1' is not a job id (letters, digits, . _ - only)"; exit 2; }
  seed_job "$1"
  [ -d "$P2V_JOBS/$1" ] || { echo "p2v: no job '$1' in $P2V_JOBS (run: p2v fetch <arxiv link> first)"; exit 2; }
}
# Bundled example jobs (2610.30340, _smoke, _smoke_ko) ship inside the skill folder.
# Copy one into the work dir the first time it is used, so builds never write into the skill folder.
seed_job() {
  local j="$1"
  [ -d "$P2V_JOBS/$j" ] || [ ! -d "$ROOT/jobs/$j" ] && return 0
  mkdir -p "$P2V_JOBS" && cp -R "$ROOT/jobs/$j" "$P2V_JOBS/$j" && rm -rf "$P2V_JOBS/$j/build"
}

# macOS: files downloaded by a quarantine-aware parent (some sandboxes, GUI apps) carry com.apple.quarantine,
# and the first dlopen/exec of them is refused or killed. Clear it right after each install step, before use.
unquarantine() { [ "$(uname)" = "Darwin" ] || return 0; local d; for d in "$@"; do [ -e "$d" ] && xattr -dr com.apple.quarantine "$d" 2>/dev/null; done; return 0; }

pick_python() {   # kokoro-onnx needs Python 3.10-3.13 (no 3.14 wheels yet)
  local c v
  for c in "${PYTHON:-}" python3.13 python3.12 python3.11 python3.10 \
           /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 \
           /usr/local/bin/python3.13 /usr/local/bin/python3.12 /usr/local/bin/python3.11 \
           /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
           /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 python3; do
    [ -n "$c" ] || continue
    command -v "$c" >/dev/null 2>&1 || [ -x "$c" ] || continue
    v=$("$c" -c 'import sys; print("%d%02d" % sys.version_info[:2])' 2>/dev/null) || continue
    if [ "$v" -ge 310 ] && [ "$v" -le 313 ]; then
      # If $c is itself inside a venv, build from its base interpreter (nested venvs can break).
      local b; b=$("$c" -c 'import os,sys; print(os.path.join(sys.base_prefix,"bin","python%d.%d" % sys.version_info[:2]))' 2>/dev/null)
      if [ -n "$b" ] && [ -x "$b" ]; then echo "$b"; else echo "$c"; fi; return 0
    fi
  done
  return 1
}

setup() {
  local T="$P2V_TOOLS"
  echo "== tools folder: $T"
  mkdir -p "$T"
  command -v node >/dev/null || { echo "!! Node 18+ is required (brew install node)"; exit 1; }
  [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 18 ] || { echo "!! Node 18+ is required (found $(node -v))"; exit 1; }
  command -v npm >/dev/null || { echo "!! npm is required (it ships with Node)"; exit 1; }
  echo "== node packages (three, ffmpeg-static, playwright)"
  if cmp -s "$ROOT/tools/package-lock.json" "$T/package-lock.json" && [ -d "$T/node_modules/three" ]; then
    echo "already installed"
  else
    cp "$ROOT/tools/package.json" "$ROOT/tools/package-lock.json" "$T/"
    (cd "$T" && npm ci --no-fund --no-audit --loglevel=error) || { rm -f "$T/package-lock.json"; exit 1; }
  fi
  [ -x "$T/node_modules/ffmpeg-static/ffmpeg" ] || (cd "$T" && node node_modules/ffmpeg-static/install.js)
  unquarantine "$T/node_modules"
  (cd "$T" && npx --yes playwright install chromium) || echo "!! Chromium install failed: render with 'p2v render <job> --manual' in any browser"
  unquarantine "${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}"
  echo "== python venv"
  local P; P=$(pick_python) || { echo "!! Need Python 3.10-3.13 (brew install python@3.12, or set PYTHON=/path/to/python3.12)"; exit 1; }
  echo "using $P ($("$P" -V))"
  if [ -x "$T/.venv/bin/python" ]; then
    local vv; vv=$("$T/.venv/bin/python" -c 'import sys; print("%d%02d" % sys.version_info[:2])' 2>/dev/null || echo 0)
    if [ "$vv" -lt 310 ] || [ "$vv" -gt 313 ]; then echo "rebuilding .venv (was $vv)"; rm -rf "$T/.venv"; fi
  fi
  [ -x "$T/.venv/bin/python" ] || "$P" -m venv "$T/.venv"
  "$T/.venv/bin/pip" install -q --upgrade pip
  "$T/.venv/bin/pip" install -q -r "$ROOT/requirements.txt"
  unquarantine "$T/.venv"
  echo "== Kokoro voice model (~350 MB, once)"
  "$T/.venv/bin/python" "$ROOT/scripts/tts.py" --download-models   # verifies size + SHA-256
  unquarantine "$T/models"
  command -v pdftotext >/dev/null || echo "note: pdftotext not found (brew install poppler); fetch falls back to pypdf"
  doctor
  echo "setup done. Optional toolchain test: $ROOT/p2v smoke"
}

doctor() {
  echo "skill   $P2V_ROOT"
  echo "tools   $P2V_TOOLS"
  echo "jobs    $P2V_JOBS"
  echo "videos  $P2V_OUT"
  local ok=1
  if [ -x "$PY" ] && "$PY" -c "import kokoro_onnx, soundfile, pypdf, supertonic" 2>/dev/null; then echo "python  ok ($("$PY" -V))"; else echo "python  missing"; ok=0; fi
  if [ -s "$P2V_TOOLS/models/kokoro-v1.0.onnx" ]; then echo "voice   ok"; else echo "voice   missing"; ok=0; fi
  command -v node >/dev/null || { echo "node    missing (install Node 18+)"; return 1; }
  local ff
  if ff=$(cd "$ROOT" && node -e "import('./scripts/lib.mjs').then(m=>console.log(m.resolveFfmpeg(process.env.P2V_ROOT)))" 2>/dev/null); then
    echo "ffmpeg  ok ($ff)"
  else
    echo "ffmpeg  missing"; ok=0
  fi
  [ -d "$P2V_TOOLS/node_modules/playwright" ] && echo "render  ok (playwright)" || echo "render  manual only (no playwright)"
  [ $ok = 1 ] || { echo "-> run: $ROOT/p2v setup"; return 1; }
}

smoke() {
  need_tools
  for j in _smoke _smoke_ko 2610.30340; do seed_job "$j"; done
  echo "== 1/4 python deps"; "$PY" -c "import numpy, kokoro_onnx, soundfile, pypdf, supertonic" && echo ok
  echo "== 2/4 kokoro tts";   "$PY" "$ROOT/scripts/tts.py" _smoke --engine kokoro
  echo "== 3/4 render";       node "$ROOT/scripts/render.mjs" _smoke
  echo "== 4/4 claims check"; "$PY" "$ROOT/scripts/check_claims.py" 2610.30340
  if [ "${1:-}" = "--ko" ]; then
    echo "== ko 1/2 supertonic tts (first run downloads the model)"; "$PY" "$ROOT/scripts/tts.py" _smoke_ko
    echo "== ko 2/2 render"; node "$ROOT/scripts/render.mjs" _smoke_ko
  fi
  echo "ALL PASS -> $P2V_JOBS/_smoke/build/_smoke.mp4"
}

run_unattended() {
  [ $# -ge 1 ] || { echo "usage: p2v run <arxiv link or id> [overrides]"; exit 2; }
  need_tools
  command -v claude >/dev/null || { echo "p2v run needs the claude CLI on PATH"; exit 1; }
  local id; id=$("$SYSPY" "$ROOT/scripts/fetch_paper.py" --id "$1") || { echo "not an arXiv link or id: $1"; exit 2; }
  mkdir -p "$P2V_HOME/logs"; local log="$P2V_HOME/logs/$id.json"
  echo "paper2video: $id  (log: $log)"
  (cd "$P2V_HOME" && claude -p "/paper2video $*" --permission-mode acceptEdits \
    --allowedTools "Bash($ROOT/p2v *),Bash($(cd "$ROOT" && pwd -P)/p2v *),Bash($HOME/.claude/skills/paper2video/p2v *),Bash(ls *),Bash(cat *),Bash(head *),Bash(wc *),Bash(grep *),Read,Write,Edit,Glob,Grep,Task,Agent" \
    --add-dir "$ROOT" --output-format json > "$log")
  "$SYSPY" -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('result','')); sys.exit(1 if d.get('is_error') else 0)" "$log"
}

CMD="${1:-help}"; shift || true
case "$CMD" in
  setup)   setup ;;
  doctor)  doctor ;;
  paths)   "$SYSPY" "$ROOT/scripts/p2v_paths.py" --shell ;;
  fetch)   need_tools; [ -n "${1:-}" ] || { echo "usage: p2v fetch <arxiv link or id>"; exit 2; }; exec "$PY" "$ROOT/scripts/fetch_paper.py" "$@" ;;
  check)   need_tools; need_job "${1:-}"; exec "$PY" "$ROOT/scripts/check_claims.py" "$@" ;;
  tts)     need_tools; need_job "${1:-}"; exec "$PY" "$ROOT/scripts/tts.py" "$@" ;;
  preview) need_tools; need_job "${1:-}"; exec node "$ROOT/scripts/render.mjs" "$1" --preview ;;
  render)  need_tools; need_job "${1:-}"; exec node "$ROOT/scripts/render.mjs" "$@" ;;
  collect) exec node "$ROOT/scripts/collect.mjs" ;;
  smoke)   smoke "${1:-}" ;;
  test)    "$SYSPY" "$ROOT/tests/test_python.py" && node "$ROOT/tests/test_server.mjs" ;;
  run)     run_unattended "$@" ;;
  help|-h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "p2v: unknown command '$CMD' (try: p2v help)"; exit 2 ;;
esac
